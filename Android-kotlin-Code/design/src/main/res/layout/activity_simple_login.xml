<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="@drawable/gradient_background">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp"
        android:gravity="center_horizontal">

        <!-- Logo区域 -->
        <ImageView
            android:id="@+id/logoImageView"
            android:layout_width="100dp"
            android:layout_height="100dp"
            android:layout_marginTop="32dp"
            android:layout_marginBottom="16dp"
            android:src="@mipmap/ic_launcher"
            android:elevation="4dp"
            android:contentDescription="@string/clash_meta_for_android" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/clash_meta_for_android"
            android:textSize="26sp"
            android:textStyle="bold"
            android:layout_marginBottom="4dp"
            android:textColor="?android:attr/textColorPrimary" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="欢迎使用 - 导入订阅即可开始"
            android:textSize="13sp"
            android:layout_marginBottom="32dp"
            android:textColor="?android:attr/textColorSecondary" />

        <!-- 主要内容卡片 -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            app:cardCornerRadius="16dp"
            app:cardElevation="4dp"
            app:cardUseCompatPadding="true">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="20dp">

                <!-- 用户名输入 -->
                <com.google.android.material.textfield.TextInputLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="16dp"
                    android:hint="用户名或昵称"
                    app:boxBackgroundMode="outline"
                    app:boxCornerRadiusTopStart="12dp"
                    app:boxCornerRadiusTopEnd="12dp"
                    app:boxCornerRadiusBottomStart="12dp"
                    app:boxCornerRadiusBottomEnd="12dp"
                    app:startIconDrawable="@drawable/ic_person_raised_hand_24px"
                    app:startIconTint="?attr/colorPrimary">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/usernameEditText"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="text"
                        android:maxLines="1"
                        android:paddingVertical="14dp" />
                </com.google.android.material.textfield.TextInputLayout>

                <!-- 订阅链接输入 -->
                <com.google.android.material.textfield.TextInputLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="12dp"
                    android:hint="订阅链接 (Clash/V2Ray)"
                    app:boxBackgroundMode="outline"
                    app:boxCornerRadiusTopStart="12dp"
                    app:boxCornerRadiusTopEnd="12dp"
                    app:boxCornerRadiusBottomStart="12dp"
                    app:boxCornerRadiusBottomEnd="12dp"
                    app:startIconDrawable="@drawable/link_24px"
                    app:startIconTint="?attr/colorPrimary"
                    app:endIconMode="custom">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/subscribeUrlEditText"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="textPassword"
                        android:maxLines="1"
                        android:paddingVertical="14dp" />

                </com.google.android.material.textfield.TextInputLayout>

                <!-- 切换可见性按钮 -->
                <ImageButton
                    android:id="@+id/togglePasswordVisibility"
                    android:layout_width="28dp"
                    android:layout_height="28dp"
                    android:layout_gravity="end"
                    android:layout_marginTop="-56dp"
                    android:layout_marginEnd="12dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:src="@drawable/visibility_off_24px"
                    android:tint="?attr/colorPrimary"
                    android:contentDescription="显示/隐藏订阅链接" />

                <!-- 提示文本 -->
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="💡 提示: 订阅链接通常以 http:// 或 https:// 开头"
                    android:textSize="12sp"
                    android:layout_marginBottom="20dp"
                    android:padding="12dp"
                    android:background="@drawable/rounded_gray_background"
                    android:textColor="?android:attr/textColorSecondary" />

                <!-- 订阅类型选择卡片 -->
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/subscription_type"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="10dp"
                    android:drawableStart="@drawable/ic_baseline_cloud_download"
                    android:drawablePadding="8dp"
                    android:drawableTint="?attr/colorPrimary"
                    android:textColor="?android:attr/textColorPrimary" />

                <RadioGroup
                    android:id="@+id/subscriptionTypeGroup"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginBottom="8dp"
                    android:background="@drawable/rounded_gray_background"
                    android:padding="8dp">

                    <RadioButton
                        android:id="@+id/radioV2ray"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/subscription_type_v2ray"
                        android:checked="true"
                        android:paddingVertical="12dp"
                        android:paddingHorizontal="12dp"
                        android:button="@null"
                        android:drawableEnd="@drawable/check_24px"
                        android:drawableTint="?attr/colorPrimary"
                        android:background="@drawable/background_selector"
                        android:textColor="?android:attr/textColorPrimary" />

                    <RadioButton
                        android:id="@+id/radioClash"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginStart="8dp"
                        android:text="@string/subscription_type_clash"
                        android:paddingVertical="12dp"
                        android:paddingHorizontal="12dp"
                        android:button="@null"
                        android:drawableEnd="@drawable/check_24px"
                        android:drawableTint="?attr/colorPrimary"
                        android:background="@drawable/background_selector"
                        android:textColor="?android:attr/textColorPrimary" />
                </RadioGroup>

            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- 操作按钮区域 -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/loginButton"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:text="✅ 登录并导入订阅"
            android:textSize="16sp"
            android:textStyle="bold"
            android:layout_marginBottom="10dp"
            android:elevation="2dp"
            app:cornerRadius="12dp"
            app:iconGravity="textStart"
            app:iconPadding="8dp" />

        <!-- 次要操作卡片 -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            app:cardCornerRadius="12dp"
            app:cardElevation="2dp"
            app:cardUseCompatPadding="true">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="12dp">

                <!-- 测试连接按钮 -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/testConnectionButton"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:text="🔍 测试订阅连接"
                    android:textSize="14sp"
                    android:layout_marginBottom="8dp"
                    style="@style/Widget.Material3.Button.OutlinedButton"
                    app:cornerRadius="10dp"
                    app:strokeWidth="1.5dp" />

                <!-- 快速导入按钮 -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/quickImportButton"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:text="📋 从剪贴板导入"
                    android:textSize="14sp"
                    style="@style/Widget.Material3.Button.OutlinedButton"
                    app:cornerRadius="10dp"
                    app:strokeWidth="1.5dp" />

            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- 跳过登录 -->
        <TextView
            android:id="@+id/skipLoginButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="⏭️ 暂时跳过"
            android:textSize="14sp"
            android:layout_marginTop="8dp"
            android:padding="12dp"
            android:textColor="?attr/colorPrimary"
            android:textStyle="bold"
            android:clickable="true"
            android:focusable="true"
            android:background="?attr/selectableItemBackgroundBorderless" />

        <!-- 说明文本卡片 -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:layout_marginBottom="20dp"
            app:cardCornerRadius="12dp"
            app:cardBackgroundColor="#1A000000"
            app:cardElevation="0dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="🔒 无需注册账号，导入订阅链接即可使用\n📱 所有数据仅保存在本地设备"
                android:textSize="12sp"
                android:padding="16dp"
                android:gravity="center"
                android:lineSpacingExtra="4dp"
                android:textColor="?android:attr/textColorSecondary" />

        </androidx.cardview.widget.CardView>

    </LinearLayout>

</ScrollView>
