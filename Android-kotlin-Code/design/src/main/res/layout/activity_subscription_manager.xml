<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?android:attr/windowBackground">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- 顶部操作栏 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="16dp">

            <ImageButton
                android:id="@+id/backButton"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:src="@drawable/ic_baseline_arrow_back"
                android:contentDescription="返回" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="订阅管理"
                android:textSize="20sp"
                android:textStyle="bold"
                android:layout_marginStart="8dp"
                android:textColor="?android:attr/textColorPrimary" />

        </LinearLayout>

        <!-- 用户信息卡片 -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            app:cardElevation="2dp"
            app:cardCornerRadius="8dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="👤 用户信息"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="12dp"
                    android:textColor="?android:attr/textColorPrimary" />

                <TextView
                    android:id="@+id/usernameText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="用户: 未登录"
                    android:textSize="14sp"
                    android:layout_marginBottom="4dp"
                    android:textColor="?android:attr/textColorSecondary" />

                <TextView
                    android:id="@+id/deviceIdText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="设备ID: --"
                    android:textSize="12sp"
                    android:textColor="?android:attr/textColorTertiary" />

            </LinearLayout>

        </com.google.android.material.card.MaterialCardView>

        <!-- 订阅信息卡片 -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            app:cardElevation="2dp"
            app:cardCornerRadius="8dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="📡 订阅信息"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="12dp"
                    android:textColor="?android:attr/textColorPrimary" />

                <TextView
                    android:id="@+id/subscriptionNameText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="订阅名称"
                    android:textSize="14sp"
                    android:layout_marginBottom="8dp"
                    android:textStyle="bold"
                    android:textColor="?android:attr/textColorPrimary" />

                <TextView
                    android:id="@+id/subscriptionUrlText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="订阅链接"
                    android:textSize="12sp"
                    android:layout_marginBottom="8dp"
                    android:ellipsize="middle"
                    android:maxLines="2"
                    android:textColor="?android:attr/textColorSecondary" />

                <TextView
                    android:id="@+id/subscriptionStatusText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="状态: --"
                    android:textSize="14sp"
                    android:layout_marginBottom="4dp"
                    android:textColor="?android:attr/textColorSecondary" />

                <TextView
                    android:id="@+id/lastUpdateText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="最后更新: --"
                    android:textSize="12sp"
                    android:layout_marginBottom="4dp"
                    android:textColor="?android:attr/textColorTertiary" />

                <TextView
                    android:id="@+id/expireTimeText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="过期时间: --"
                    android:textSize="12sp"
                    android:textColor="?android:attr/textColorTertiary" />

                <!-- 操作按钮 -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginTop="12dp">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/updateSubscriptionButton"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="更新"
                        android:textSize="12sp"
                        android:layout_marginEnd="8dp"
                        style="@style/Widget.Material3.Button.TonalButton" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/copyUrlButton"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="复制链接"
                        android:textSize="12sp"
                        style="@style/Widget.Material3.Button.OutlinedButton" />

                </LinearLayout>

            </LinearLayout>

        </com.google.android.material.card.MaterialCardView>

        <!-- 流量统计卡片 -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            app:cardElevation="2dp"
            app:cardCornerRadius="8dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="📊 流量统计"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="12dp"
                    android:textColor="?android:attr/textColorPrimary" />

                <!-- 订阅流量 -->
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="订阅流量"
                    android:textSize="12sp"
                    android:layout_marginBottom="4dp"
                    android:textColor="?android:attr/textColorTertiary" />

                <TextView
                    android:id="@+id/trafficUsageText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="0 B / 无限制"
                    android:textSize="14sp"
                    android:layout_marginBottom="8dp"
                    android:textColor="?android:attr/textColorPrimary" />

                <ProgressBar
                    android:id="@+id/trafficProgressBar"
                    style="?android:attr/progressBarStyleHorizontal"
                    android:layout_width="match_parent"
                    android:layout_height="8dp"
                    android:layout_marginBottom="16dp"
                    android:max="100"
                    android:progress="0" />

                <!-- 本地流量统计 -->
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="本地统计(本次会话)"
                    android:textSize="12sp"
                    android:layout_marginBottom="8dp"
                    android:textColor="?android:attr/textColorTertiary" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginBottom="4dp">

                    <TextView
                        android:id="@+id/uploadText"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="↑ 上传: 0 B"
                        android:textSize="14sp"
                        android:textColor="?android:attr/textColorSecondary" />

                    <TextView
                        android:id="@+id/downloadText"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="↓ 下载: 0 B"
                        android:textSize="14sp"
                        android:textColor="?android:attr/textColorSecondary" />

                </LinearLayout>

                <TextView
                    android:id="@+id/totalTrafficText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="总计: 0 B"
                    android:textSize="14sp"
                    android:layout_marginBottom="12dp"
                    android:textStyle="bold"
                    android:textColor="?android:attr/textColorPrimary" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/resetTrafficButton"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="重置流量统计"
                    android:textSize="12sp"
                    style="@style/Widget.Material3.Button.OutlinedButton" />

            </LinearLayout>

        </com.google.android.material.card.MaterialCardView>

        <!-- 导入新订阅按钮 -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/importNewSubscriptionButton"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:text="📥 导入新订阅"
            android:textSize="14sp"
            app:cornerRadius="8dp" />

    </LinearLayout>

</ScrollView>
